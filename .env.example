# Copy this file to .env and add your keys
GOOGLE_API_KEY=your-gemini-api-key        # free: https://aistudio.google.com/app/apikey
TAVILY_API_KEY=your-tavily-api-key        # free: https://app.tavily.com
GEMINI_MODEL=gemini-2.5-flash

# Optional tuning
MAX_SUB_QUESTIONS=4
RESULTS_PER_QUERY=3
MAX_REVIEW_LOOPS=2
